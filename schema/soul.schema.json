{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ohgeeceee.github.io/soulregistry/schema/soul.schema.json",
  "title": "SOUL.md Registry — soul.json",
  "description": "Metadata sidecar for a SOUL.md file in the registry. See SPEC.md.",
  "type": "object",
  "required": [
    "name",
    "slug",
    "version",
    "description",
    "category",
    "tags",
    "author",
    "license",
    "soul_format",
    "created",
    "updated"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 48,
      "description": "Display name of the soul."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 48,
      "description": "URL-safe identifier. Must equal the containing directory name."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver version of this soul."
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 140,
      "description": "One-line summary, no newlines."
    },
    "category": {
      "type": "string",
      "enum": [
        "research",
        "engineering",
        "operations",
        "security",
        "education",
        "product",
        "creative",
        "support",
        "personal",
        "experimental"
      ]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "maxLength": 24
      }
    },
    "author": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]+$",
      "description": "GitHub handle of the contributor."
    },
    "license": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "description": "SPDX identifier, e.g. MIT or Apache-2.0."
    },
    "soul_format": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "SPEC.md version this soul targets."
    },
    "compatibility": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "claude-code",
          "cursor",
          "openclaw",
          "hermes",
          "chatgpt",
          "codex",
          "aider",
          "opencode",
          "generic"
        ]
      }
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "maintainers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9-]+$"
      },
      "description": "Additional GitHub handles maintaining this soul."
    }
  }
}